rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ブロック崩しのランキング: 誰でも読める・追加だけできる（更新・削除は不可）
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'stage', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 5000000
        && request.resource.data.stage is int
        && request.resource.data.stage >= 1
        && request.resource.data.stage <= 8
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
